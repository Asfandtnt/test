rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in user is an admin when a document with their UID exists in
    // the "admins" collection. Create it once from the Firebase console.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Catalogue: public read, admin write.
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Store settings (WhatsApp number, delivery fee, announcement).
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: customers may place an order, only admins can see or change them.
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasAll(['customer', 'items', 'total', 'status', 'createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.customer.name is string
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.address is string;
      allow read, update, delete: if isAdmin();
    }
  }
}
